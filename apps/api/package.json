{
  "name": "@paper-wars/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@paper-wars/world": "workspace:*",
    "@paper-wars/simulation": "workspace:*",
    "fastify": "^4.28.1",
    "@paper-wars/auth": "workspace:*",
    "@paper-wars/persistence": "workspace:*",
    "@paper-wars/randomness": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "clean": "rm -rf dist"
  }
}
