{
  "name": "paperwars-rebirth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm build && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yml,yaml}\"",
    "test": "pnpm build && pnpm --filter @paper-wars/tests test",
    "test:smoke": "pnpm test",
    "clean": "pnpm -r --workspace-concurrency=1 --if-present clean",
    "dev:api": "pnpm --filter @paper-wars/api dev",
    "start:api": "pnpm --filter @paper-wars/api start"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
